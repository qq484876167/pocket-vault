    <application>
        <provider
            android:name="com.qoder.pocketvault.support.FakeSafProvider"
            android:authorities="com.qoder.pocketvault.testdocs"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
